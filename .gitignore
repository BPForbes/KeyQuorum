# Rust
/target/
/debug/
**/*.rs.bk
*.pdb

# Cargo mutants testing artifacts
**/mutants.out*/

# Environment / local config
.env
.env.*
!.env.example

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Python tooling, if used
__pycache__/
*.py[cod]
.venv/
venv/

# Tauri / frontend, if added later
node_modules/
dist/
build/

# Security-sensitive local artifacts
*.key
*.pem
*.secret
*.token
*.kqkey
*.kqpb
*.kqbn
*.kqcert
*.kqrl
*.kqpolicy
*.kqst
# Tracked-file containers carry file content; quorum ciphertext, export
# bundles, history snapshots, signature artifacts and transfer packages
# are working files that belong to one store, never to the repository.
*.kqtf
*.kqtf.lock
*.kqenc
*.kqxb
*.kqhs
*.kqbs
*.kqtx
device.kq
device.skey
secrets/
keys/
test-keys/
provider-secrets/
# systemd-creds encrypted credentials and files handed to a relay at run time
*.cred
/deploy/**/*.local.*

# Cloudflare Worker and Terraform: local secrets, build output and state. The
# provider lock file (.terraform.lock.hcl) is committed on purpose.
.dev.vars
.dev.vars.*
.wrangler/
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars
*.auto.tfvars
crash.log

# Local encrypted/decrypted test files
tmp/
temp/
scratch/

# Local SQLite databases (may contain decrypted key/file metadata)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Editor backups
*~
*.bak

# Browser lab (lab/): generated WASM bindings and test output
/lab/src/wasm/
/lab/test-results/
/lab/playwright-report/
/lab/public/project-metadata.json
