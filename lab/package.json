{
  "name": "keyquorum-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --strictPort --port 4173 --host 127.0.0.1",
    "test:browser": "playwright test",
    "generate:metadata": "node scripts/generate-project-metadata.mjs",
    "validate:metadata": "node scripts/generate-project-metadata.mjs --validate dist/project-metadata.json",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
