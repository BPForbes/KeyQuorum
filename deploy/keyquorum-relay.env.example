# Non-secret runtime settings for the KeyQuorum relay systemd unit
# (deploy/systemd/keyquorum-relay.service reads /etc/keyquorum/relay.env).
#
# Install as /etc/keyquorum/relay.env, root:keyquorum, mode 0640.
#
# This file must never hold a relay private key, a provider-root key, a
# customer kq_ bearer, the kql_ operator lock, a MongoDB connection string
# with a password, or a slot passphrase. Those arrive as files: the relay
# key through the unit's LoadCredentialEncrypted=, the operator lock through
# --licensee-key-file on the operator's own session. `.env` files are
# ignored by git (.gitignore); this example is the only one committed.

# Where the relay listens. Loopback unless a TLS proxy on another host
# forwards to it (then also add --behind-tls-proxy to ExecStart).
KEYQUORUM_BIND=127.0.0.1:8787

# The public, KeyQuorum-root-signed trust material (read-only, root-owned).
KEYQUORUM_PROVIDER_CERT=/etc/keyquorum/provider.kqcert
KEYQUORUM_PROVIDER_KRL=/etc/keyquorum/provider.kqrl

# Requests each client may make per minute before a 429 (0 turns the
# relay's limiter off; then limit at the proxy).
KEYQUORUM_RATE_LIMIT_PER_MINUTE=600

# How often expired letters are purged and the audit chain heads signed.
KEYQUORUM_SCAN_INTERVAL_SECONDS=60

# Log level (tracing filter). INFO records denials and purges by reason.
RUST_LOG=info

# A hosted relay on MongoDB names its connection string FILE here instead of
# a SQLite path (the file is a mounted secret, root:keyquorum 0640, and
# needs a binary built with --features provider,mongodb):
# KEYQUORUM_MONGODB_URI_FILE=/etc/keyquorum/mongodb-uri
# KEYQUORUM_MONGODB_DB=keyquorum
