# KeyQuorum relay as a systemd service: single-node, on-premises or
# development. The hosted-cloud path is the container image and the Helm
# chart under deploy/kubernetes; this unit is for a relay that keeps its
# state in the owner-only SQLite file under /var/lib/keyquorum.
#
# Install:
#   install -m 0644 deploy/systemd/keyquorum-relay.service /etc/systemd/system/
#   install -m 0644 deploy/systemd/keyquorum-relay.tmpfiles.conf /etc/tmpfiles.d/keyquorum-relay.conf
#   systemd-tmpfiles --create /etc/tmpfiles.d/keyquorum-relay.conf
#   systemctl daemon-reload && systemctl enable --now keyquorum-relay
#
# What this unit gives the relay, and what it never does:
#   - the relay private key, decrypted by systemd into the service's private
#     credential directory (LoadCredentialEncrypted=) and passed as a file
#     path: it is never in the environment, the unit file or a log;
#   - provider.kqcert and provider.kqrl, read-only from /etc/keyquorum
#     (public, but signed: keep them where only root writes);
#   - a writable /var/lib/keyquorum for the relay database, and nothing
#     else writable.
# It never carries the provider-root private key (offline only), a customer
# bearer, or the kql_ operator lock (host `keys` commands take that from a
# file on the operator's own session, see docs/operator/relay-secrets.md).
# Placeholders: the hostname belongs in the reverse proxy
# (deploy/caddy/Caddyfile.example), not here.

[Unit]
Description=KeyQuorum relay (mailbox host)
Documentation=file:///usr/share/doc/keyquorum/relay-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keyquorum
Group=keyquorum

# Non-secret settings: edit deploy/keyquorum-relay.env.example and install
# it as /etc/keyquorum/relay.env (root:keyquorum 0640). It must hold no
# key, bearer or passphrase; see the comments in that file.
EnvironmentFile=-/etc/keyquorum/relay.env

# The relay private key. Production: encrypt it once with
#   systemd-creds encrypt --name=relay-key relay.key /etc/credstore.encrypted/keyquorum-relay-key.cred
# (optionally bound to the host's TPM2 with --with-key=tpm2) and delete the
# plaintext. systemd decrypts it into $CREDENTIALS_DIRECTORY/relay-key for
# this service only. Development or a host without systemd-creds: replace
# the line with
#   LoadCredential=relay-key:/etc/keyquorum/relay.key
# (an owner-only root:root 0600 file).
LoadCredentialEncrypted=relay-key:/etc/credstore.encrypted/keyquorum-relay-key.cred

# The relay serves plain HTTP on loopback; Caddy (or another TLS-terminating
# proxy) listens on 443 and forwards to it. --behind-tls-proxy makes the
# per-client rate limit apply to the end client the proxy names in
# X-Forwarded-For (deploy/caddy/Caddyfile.example sets it to one verified
# address) rather than to the proxy's loopback address, which every customer
# would otherwise share. It is safe here only because the relay binds loopback:
# keep KEYQUORUM_BIND on loopback unless the proxy is on another host over a
# private path, and never expose the relay's port directly.
ExecStart=/usr/local/bin/keyquorum \
    --mailbox-db /var/lib/keyquorum/relay.sqlite \
    host serve \
    --bind ${KEYQUORUM_BIND} \
    --behind-tls-proxy \
    --cert ${KEYQUORUM_PROVIDER_CERT} \
    --krl ${KEYQUORUM_PROVIDER_KRL} \
    --relay-key ${CREDENTIALS_DIRECTORY}/relay-key \
    --rate-limit-per-minute ${KEYQUORUM_RATE_LIMIT_PER_MINUTE} \
    --scan-interval-seconds ${KEYQUORUM_SCAN_INTERVAL_SECONDS}

Restart=on-failure
RestartSec=5s
# systemd's default SIGTERM ends the server gracefully (SIGINT does too).
TimeoutStopSec=30s

# Files the relay creates (the database and its journal) are owner-only.
UMask=0077
WorkingDirectory=/var/lib/keyquorum
StateDirectory=keyquorum
StateDirectoryMode=0700

# Sandbox. ProtectSystem=strict makes the whole filesystem read-only except
# the paths listed; the relay writes only its state directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/keyquorum
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Journald keeps the relay's log. The relay logs denials and purges by
# reason; it never logs a bearer, a key hash or a challenge.
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
